{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/viniburilux/TraceFoundry/blob/main/schemas/claim_audit.schema.json",
  "title": "TraceFoundry Claim Audit Registry",
  "description": "Public, provenance-first registry for reviewing claims without embedding raw scientific data or private memory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "claims"],
  "properties": {
    "schema_version": {"type": "string"},
    "registry_id": {"type": "string"},
    "source_policy": {"type": "string"},
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "statement", "status", "evidence_ids", "source_uris"],
      "properties": {
        "claim_id": {"type": "string"},
        "statement": {"type": "string", "minLength": 1},
        "status": {
          "type": "string",
          "enum": ["observed", "inferred", "hypothesis", "insufficient", "blocked", "rejected", "contradicted"]
        },
        "scope": {"type": "string"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "source_uris": {"type": "array", "items": {"format": "uri", "type": "string"}},
        "correction": {"type": "string"},
        "note": {"type": "string"},
        "next_gate": {"type": "string"}
      }
    }
  }
}
